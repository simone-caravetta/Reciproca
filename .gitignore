# Python
__pycache__/
*.pyc

# Chrome persistent profile (contains session/login data - never commit)
chrome_profile/

# Runtime state generated by the app
follow_queue.json
follow_queue.json.backup
followed_history.json
user_frequencies.json
scraped_authors.json
hashtags.json
bot_config.json
unfollow_progress.json
unfollow_progress_*.json
unfollow_last_session.json
follow_bot.log
follow_logs_*.txt

# The sentence model for the semantic ranking, fetched on first use and written
# next to the app like everything else it generates. Over a hundred megabytes, and
# nothing here authored it: see MODEL_REPO in reciproca.py for where it comes from.
# Deleting this folder is how you make it download again.
model/

# Instagram data exports the user supplies locally
followers.json
following.json

# PyInstaller build output (reciproca.spec itself is tracked)
build/
dist/

# Node modules for the optional DOM test
node_modules/
package-lock.json

# Local per-machine Claude Code settings
.claude/settings.local.json

# Safety copies of runtime state made before data edits
*.bak
